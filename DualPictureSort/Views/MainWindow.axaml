<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DualPictureSort.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:DualPictureSort.Views"
        mc:Ignorable="d" d:DesignWidth="1350" d:DesignHeight="850"
        x:Class="DualPictureSort.Views.MainWindow"
        Icon="/Assets/avalonia-logo.ico"
        Title="Dual Picture Sort - GMTPC"
        Width="1350" Height="850"
        MinWidth="850" MinHeight="550"
        WindowStartupLocation="CenterScreen">
        <views:MainView />
</Window>
